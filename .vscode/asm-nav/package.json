{
    "name": "phoonzang-asm-nav",
    "displayName": "PHOONZANG asm navigation",
    "description": "Navigation, hover, sidecar naming and Manx cc/as diagnostics for the generated C, Manx assembly (.s) and NASM trees.",
    "publisher": "local",
    "version": "0.0.2",
    "engines": { "vscode": "^1.70.0" },
    "activationEvents": ["onStartupFinished"],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            { "command": "PHOONZANGAsmNav.reindex", "title": "PHOONZANG:Reindex asm labels" },
            { "command": "PHOONZANGAsmNav.goToAddress", "title": "PHOONZANG:Go to address" },
            { "command": "PHOONZANGAsmNav.nameRoutine", "title": "PHOONZANG:Name this routine (sidecar)" },
            { "command": "PHOONZANGAsmNav.diffVendor", "title": "PHOONZANG:Diff against vendor seed" },
            { "command": "PHOONZANGAsmNav.check", "title": "PHOONZANG:Check with Manx cc/as" },
            { "command": "PHOONZANGAsmNav.makeC", "title": "PHOONZANG:Make C file (Claude)" }
        ],
        "menus": {
            "editor/context": [
                { "command": "PHOONZANGAsmNav.nameRoutine", "when": "resourcePath =~ /src_[^/]+\\//", "group": "PHOONZANG@1" },
                { "command": "PHOONZANGAsmNav.diffVendor", "when": "resourcePath =~ /src_[^/]+\\/.*\\.[cs]$/", "group": "PHOONZANG@2" },
                { "command": "PHOONZANGAsmNav.makeC", "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/", "group": "PHOONZANG@3" }
            ],
            "explorer/context": [
                { "command": "PHOONZANGAsmNav.makeC", "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/", "group": "PHOONZANG@3" }
            ]
        },
        "keybindings": [
            { "command": "PHOONZANGAsmNav.goToAddress", "key": "ctrl+alt+g" }
        ],
        "configuration": {
            "title": "PHOONZANG asm navigation",
            "properties": {
                "PHOONZANGAsmNav.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Build a routine's .c (Manx cc) or .s (Manx as) with the real tool on save and show its errors and warnings."
                },
                "PHOONZANGAsmNav.checkOnOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Also run the Manx check when a routine's .c or .s is opened (and for files already open at start-up)."
                },
                "PHOONZANGAsmNav.claude": {
                    "type": "string",
                    "default": "claude",
                    "description": "Claude Code CLI used by 'Make C file' (uses its existing OAuth login)."
                },
                "PHOONZANGAsmNav.claudeModel": {
                    "type": "string",
                    "default": "",
                    "description": "Model for 'Make C file'; empty uses the CLI default."
                },
                "PHOONZANGAsmNav.python": {
                    "type": "string",
                    "default": "python3",
                    "description": "Python used to run .vscode/cccheck.py."
                }
            }
        }
    }
}
