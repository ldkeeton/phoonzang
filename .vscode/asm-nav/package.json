{
    "name": "phoonzang-asm-nav",
    "displayName": "PHOONZANG asm navigation",
    "description": "Navigation, hover, sidecar naming and Manx cc/as diagnostics for the generated C, Manx assembly (.s) and NASM trees.",
    "publisher": "local",
    "version": "0.0.3",
    "engines": {
        "vscode": "^1.70.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "asm-x86-nasm",
                "aliases": [
                    "NASM (PHOONZANG)"
                ],
                "extensions": [
                    ".asm",
                    ".s"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "asm-x86-nasm",
                "scopeName": "source.phoonzang.nasm",
                "path": "./syntaxes/nasm.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "PHOONZANGAsmNav.reindex",
                "title": "PHOONZANG:Reindex asm labels"
            },
            {
                "command": "PHOONZANGAsmNav.goToAddress",
                "title": "PHOONZANG:Go to address"
            },
            {
                "command": "PHOONZANGAsmNav.nameRoutine",
                "title": "PHOONZANG:Name this routine (sidecar)"
            },
            {
                "command": "PHOONZANGAsmNav.check",
                "title": "PHOONZANG:Check with Manx cc/as"
            },
            {
                "command": "PHOONZANGAsmNav.makeC",
                "title": "PHOONZANG:Make C file (Claude)"
            },
            {
                "command": "PHOONZANGAsmNav.makeCOpenCode",
                "title": "PHOONZANG:Make C file (OpenCode)"
            },
            {
                "command": "PHOONZANGAsmNav.makeCCodex",
                "title": "PHOONZANG:Make C file (OpenAI Codex)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "PHOONZANGAsmNav.nameRoutine",
                    "when": "resourcePath =~ /src_[^/]+\\//",
                    "group": "PHOONZANG@1"
                },
                {
                    "command": "PHOONZANGAsmNav.makeC",
                    "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/",
                    "group": "PHOONZANG@3"
                },
                {
                    "command": "PHOONZANGAsmNav.makeCOpenCode",
                    "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/",
                    "group": "PHOONZANG@4"
                },
                {
                    "command": "PHOONZANGAsmNav.makeCCodex",
                    "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/",
                    "group": "PHOONZANG@5"
                }
            ],
            "explorer/context": [
                {
                    "command": "PHOONZANGAsmNav.makeC",
                    "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/",
                    "group": "PHOONZANG@3"
                },
                {
                    "command": "PHOONZANGAsmNav.makeCOpenCode",
                    "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/",
                    "group": "PHOONZANG@4"
                },
                {
                    "command": "PHOONZANGAsmNav.makeCCodex",
                    "when": "resourcePath =~ /src_[^/]+\\/[^/]+\\/.*\\.asm$/",
                    "group": "PHOONZANG@5"
                }
            ]
        },
        "keybindings": [
            {
                "command": "PHOONZANGAsmNav.goToAddress",
                "key": "ctrl+alt+g"
            }
        ],
        "configuration": {
            "title": "PHOONZANG asm navigation",
            "properties": {
                "PHOONZANGAsmNav.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Build a routine's .c (Manx cc) or .s (Manx as) with the real tool on save and show its errors and warnings."
                },
                "PHOONZANGAsmNav.checkOnOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Also run the Manx check when a routine's .c or .s is opened (and for files already open at start-up)."
                },
                "PHOONZANGAsmNav.claude": {
                    "type": "string",
                    "default": "claude",
                    "description": "Claude Code CLI used by 'Make C file (Claude)' (uses its existing OAuth login)."
                },
                "PHOONZANGAsmNav.claudeModel": {
                    "type": "string",
                    "default": "",
                    "description": "Model for 'Make C file (Claude)'; empty uses the CLI default."
                },
                "PHOONZANGAsmNav.opencode": {
                    "type": "string",
                    "default": "opencode",
                    "description": "OpenCode CLI used by 'Make C file (OpenCode)' (uses its existing login)."
                },
                "PHOONZANGAsmNav.opencodeModel": {
                    "type": "string",
                    "default": "",
                    "description": "Model for 'Make C file (OpenCode)' as provider/model; empty uses the CLI default."
                },
                "PHOONZANGAsmNav.codex": {
                    "type": "string",
                    "default": "/usr/lib/chatgpt/resources/codex",
                    "description": "Path to the OpenAI Codex CLI executable used by 'Make C file (OpenAI Codex)'. On this system it is bundled at /usr/lib/chatgpt/resources/codex."
                },
                "PHOONZANGAsmNav.codexModel": {
                    "type": "string",
                    "default": "",
                    "description": "Model for 'Make C file (OpenAI Codex)'; empty uses the CLI default."
                },
                "PHOONZANGAsmNav.python": {
                    "type": "string",
                    "default": "python3",
                    "description": "Python used to run .vscode/cccheck.py."
                }
            }
        }
    }
}
