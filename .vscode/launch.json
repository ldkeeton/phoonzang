{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB: Launch TESTCOM",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/testcom.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "${workspaceFolder}/debugger/gdb_mi_proxy.py",
            "MIMode": "gdb",
            "targetArchitecture": "x86",
            "stopAtEntry": true,
            "stopAtConnect": true,
            "cwd": "${workspaceFolder}/debugger",
            "preLaunchTask": "Start DOSBox-X (COM)",
            "sourceFileMap": {
                "/media/lyle/ST8000DM004/Games/Wiz7/debugger/": "${workspaceFolder}/debugger/"
            },
            "setupCommands": [
                {
                    "text": "set architecture i8086",
                    "description": "GDBSRV 16-bit real-mode target",
                    "ignoreFailures": false
                },
                {
                    "text": "set confirm off",
                    "description": "No prompts",
                    "ignoreFailures": true
                },
                {
                    "text": "source ${workspaceFolder}/debugger/gdb_enable_phys.py",
                    "description": "Real-mode address translation",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "engineLogging": true
            }
        },
        {
            "name": "GDB: Launch TESTEXE",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/testexe.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "${workspaceFolder}/debugger/gdb_mi_proxy.py",
            "MIMode": "gdb",
            "targetArchitecture": "x86",
            "stopAtEntry": true,
            "stopAtConnect": true,
            "cwd": "${workspaceFolder}/debugger",
            "preLaunchTask": "Start DOSBox-X (MZ EXE)",
            "sourceFileMap": {
                "/media/lyle/ST8000DM004/Games/Wiz7/debugger/": "${workspaceFolder}/debugger/"
            },
            "setupCommands": [
                {
                    "text": "set architecture i8086",
                    "description": "GDBSRV 16-bit real-mode target",
                    "ignoreFailures": false
                },
                {
                    "text": "set confirm off",
                    "description": "No prompts",
                    "ignoreFailures": true
                },
                {
                    "text": "source ${workspaceFolder}/debugger/gdb_enable_phys.py",
                    "description": "Real-mode address translation",
                    "ignoreFailures": true
                },
                {
                    "text": " set debug remote 1",
                    "description": "set debug remote 1",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "engineLogging": true
            }
        },
        {
            "name": "GDB: Attach (manual dosbox-x)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/testcom.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "stopAtConnect": true,
            "cwd": "${workspaceFolder}/debugger",
            "sourceFileMap": {
                "/media/lyle/ST8000DM004/Games/Wiz7/debugger/": "${workspaceFolder}/debugger/"
            },
            "setupCommands": [
                {
                    "text": "set architecture i8086",
                    "description": "GDBSRV 16-bit real-mode target",
                    "ignoreFailures": false
                },
                {
                    "text": "source ${workspaceFolder}/debugger/gdb_enable_phys.py",
                    "description": "Real-mode address translation",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "GDB: Launch DSAVANT (DS.EXE)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src_DSAVANT/build_out/DS.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "${workspaceFolder}/debugger/gdb_mi_proxy.py",
            "MIMode": "gdb",
            "targetArchitecture": "x86",
            "stopAtEntry": true,
             
            "cwd": "${workspaceFolder}/src_DSAVANT/build_out",
            "preLaunchTask": "Start DOSBox-X (DSAVANT)",
            "sourceFileMap": {
                "/media/lyle/ST8000DM004/Games/Wiz7/src_DSAVANT/build_out/.elf-rebuild/": "${workspaceFolder}/src_DSAVANT/"
            },
            "setupCommands": [
                {
                    "text": "set architecture i8086",
                    "description": "16-bit MZ real-mode target",
                    "ignoreFailures": false
                },
                {
                    "text": "set confirm off",
                    "description": "No prompts",
                    "ignoreFailures": true
                },
                {
                    "text": "source ${workspaceFolder}/debugger/gdb_enable_phys.py",
                    "description": "Physical EIP mode",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "engineLogging": true
            }
        }
    ]
}
