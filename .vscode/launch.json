{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB: Launch dosbox-x",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/debug.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "targetArchitecture": "x86",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/debugger",
            "preLaunchTask": "Start dosbox-x + GDBSRV",
            "sourceFileMap": {
                "/media/lyle/ST8000DM004/Games/Wiz7/debugger/": "${workspaceFolder}/debugger/"
            },
            "setupCommands": [
                {
                    "text": "set architecture i386",
                    "description": "32-bit for cppdbg compat",
                    "ignoreFailures": false
                },
                {
                    "text": "set confirm off",
                    "description": "No prompts",
                    "ignoreFailures": true
                },
                {
                    "text": "source ${workspaceFolder}/debugger/gdb_enable_phys.py",
                    "description": "Physical EIP mode",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "engineLogging": true
            }
        },
        {
            "name": "GDB: Attach (manual dosbox-x)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/debug.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}/debugger",
            "sourceFileMap": {
                "/media/lyle/ST8000DM004/Games/Wiz7/debugger/": "${workspaceFolder}/debugger/"
            },
            "setupCommands": [
                {
                    "text": "set architecture i8086",
                    "description": "16-bit real-mode",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
