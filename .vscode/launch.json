{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run ASM (dosemu2)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "dosemu",
            "runtimeArgs": [
                "-K", "${workspaceFolder}/decompiled_asm_3/build_out",
                "-E", "DS.EXE",
                "-X", "-q",
                "-f", "${workspaceFolder}/.vscode/dosemurc"
            ],
            "preLaunchTask": "Build ASM",
        },
        {
            "name": "GDBSRV stub (dosbox-x)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/dummy.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": true,
            "setupCommands": [
                { "text": "set architecture i8086", "ignoreFailures": true },
                { "text": "set disassembly-flavor intel", "ignoreFailures": true },
                { "text": "set confirm off", "ignoreFailures": true },
                { "text": "handle SIGALRM nopass", "ignoreFailures": true }
            ],
            "preLaunchTask": "Start dosbox-x + GDBSRV",
            "externalConsole": false
        }
    ]
}
