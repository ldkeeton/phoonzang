{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB: Launch dosbox-x",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/debug.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "${workspaceFolder}/debugger",
            "preLaunchTask": "Start dosbox-x + GDBSRV",
            "setupCommands": [
                {"text": "set architecture i8086", "ignoreFailures": true}
            ]
        },
        {
            "name": "GDB: Attach (manual dosbox-x)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debugger/build/debug.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "${workspaceFolder}/debugger",
            "setupCommands": [
                {"text": "set architecture i8086", "ignoreFailures": true}
            ]
        },
        {
            "name": "Run ASM (dosemu2)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "dosemu",
            "runtimeArgs": [
                "-K", "${workspaceFolder}/decompiled_asm_3/build_out",
                "-E", "DS.EXE",
                "-X", "-q",
                "-f", "${workspaceFolder}/.vscode/dosemurc"
            ],
            "preLaunchTask": "Build ASM",
        }
    ]
}
