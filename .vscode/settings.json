{   "C_Cpp.default.cStandard": "c89",
    "C_Cpp.intelliSenseEngine": "Tag Parser",
    "C_Cpp.errorSquiggles": "disabled",
    "files.associations": {
        "*.asm": "asm-x86-nasm",
        "*.s": "asm-x86-nasm"
    },
    "editor.semanticHighlighting.enabled": true,
    "debug.allowBreakpointsEverywhere": true,
    // Find All References opens the inline peek list (fresh each time) rather than
    // the References side panel, which keeps a history of past searches.
    "references.preferredLocation": "peek",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.c": "$(capture).asm",
        "*.s": "$(capture).asm"
    },
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.files.associations": { "*.s": "c" }
    //"search.useIgnoreFiles": false
}
