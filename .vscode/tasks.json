{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build GDBSRV",
            "type": "shell",
            "command": "make",
            "args": ["-C", "debugger", "clean", "all"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start DOSBox-X (COM)",
            "type": "shell",
            "isBackground": true,
            "command": "${workspaceFolder}/debugger/start-dosbox-x.sh",
            "args": ["testcom"],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting dosbox-x",
                    "endsPattern": "__READY__"
                }
            },
            "dependsOn": ["Build GDBSRV"],
            "dependsOrder": "sequence",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Start DOSBox-X (MZ EXE)",
            "type": "shell",
            "isBackground": true,
            "command": "${workspaceFolder}/debugger/start-dosbox-x.sh",
            "args": ["testexe"],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting dosbox-x",
                    "endsPattern": "__READY__"
                }
            },
            "dependsOn": ["Build GDBSRV"],
            "dependsOrder": "sequence",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Build DSAVANT ELF",
            "type": "shell",
            "command": "make",
            "args": ["-C", "asm", "elf-rebuild", "DSAVANT", "ds"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start DOSBox-X (DSAVANT)",
            "type": "shell",
            "isBackground": true,
            "command": "${workspaceFolder}/debugger/start-dosbox-x.sh",
            "args": ["dsavant"],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting dosbox-x",
                    "endsPattern": "__READY__"
                }
            },
            "dependsOn": ["Build GDBSRV", "Build DSAVANT ELF"],
            "dependsOrder": "sequence",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Manx cc: check current file",
            "type": "shell",
            "command": "python3",
            "args": ["${workspaceFolder}/.vscode/cccheck.py", "${file}"],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "manx-cc",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (error|warning): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
